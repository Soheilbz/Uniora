# Long-running platform worker profile; do not add owner or Web secrets here.
DATABASE_PLATFORM_URL=postgresql://univ_platform_worker:replace-me@db.example:5432/univ?sslmode=verify-full
DATABASE_URL=postgresql://univ_app_web:replace-me@db.example:5432/univ?sslmode=verify-full
BETTER_AUTH_SECRET=replace-with-a-production-secret-at-least-32-characters
BETTER_AUTH_URL=https://univ.example.com
PLATFORM_OPERATOR=operator@example.com
PLATFORM_OPERATION_ENCRYPTION_KEY=replace-with-a-distinct-platform-key-at-least-32-chars
BACKUP_ACTIVE_KEY_ID=replace-me
BACKUP_ENCRYPTION_KEYS=replace-me
BACKUP_DIR=/srv/univ/backups
