# Web production profile. Never put owner, worker, backup, or audit credentials here.
NODE_ENV=production
DATABASE_URL=postgresql://univ_app_web:replace-me@db.example:5432/univ?sslmode=verify-full
BETTER_AUTH_SECRET=replace-with-a-random-production-secret-at-least-32-chars
BETTER_AUTH_URL=https://univ.example.com
TRUSTED_ORIGINS=https://univ.example.com
EXPORT_JOB_DIR=/srv/univ/exports
MFA_ACTIVE_KEY_ID=replace-me
MFA_ENCRYPTION_KEYS=replace-me
PLATFORM_OPERATION_ENCRYPTION_KEY=replace-with-a-random-platform-key-at-least-32-chars
PLATFORM_SESSION_HOURS=4
INTEGRATION_ENCRYPTION_KEY=replace-with-a-random-integration-key-at-least-32-chars
PUBLIC_FORM_RATE_SALT=replace-with-a-random-public-form-salt-at-least-32-chars
OBJECT_STORAGE_ENDPOINT=https://storage.example.com
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://storage.example.com
OBJECT_STORAGE_BROWSER_ORIGIN=https://storage.example.com
OBJECT_STORAGE_BUCKET=univ-production
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
TRUSTED_PROXY_HOPS=1
