# Copy to .env.database.local for local PostgreSQL provisioning.
DATABASE_ADMIN_URL=postgresql://univ_owner:local@127.0.0.1:5446/univ?sslmode=disable
APP_DB_PASSWORD=local
WORKER_DB_PASSWORD=local
PLATFORM_DB_PASSWORD=local
DATABASE_URL=postgresql://univ_app_web:local@127.0.0.1:5446/univ?sslmode=disable
DATABASE_WORKER_URL=postgresql://univ_job_worker:local@127.0.0.1:5446/univ?sslmode=disable
DATABASE_PLATFORM_URL=postgresql://univ_platform_worker:local@127.0.0.1:5446/univ?sslmode=disable
SEED_ADMIN_PASSWORD=replace-with-a-local-admin-password
TENANT_ADMIN_PASSWORD=replace-with-a-local-tenant-password
PLATFORM_OPERATOR_USERNAME=operator
PLATFORM_OPERATOR_PASSWORD=replace-with-a-local-platform-operator-password
