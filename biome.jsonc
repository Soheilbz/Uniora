{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.next",
      // Release and shard builds use suffixed Next output directories too.
      // They contain generated Turbopack chunks, never application source.
      "!**/.next-*",
      "!**/node_modules",
      // This is an exact third-party pnpm runtime, verified by manifest hash;
      // it is not first-party source and must not be reformatted by CI.
      "!**/toolchain",
      // Optional project-local toolchain/runtime state. Source archives do not
      // include it, and when present none of its generated bytes are ours.
      "!**/.univ",
      // Generated by drizzle-kit from the schema, and by Next on every build.
      // Formatting either one is a diff that comes straight back.
      "!**/drizzle",
      // An image, not source: Biome has no SVG formatter, and the file is
      // served verbatim.
      "!**/icon.svg",
      // Playwright's output: trace snapshots and saved sessions are captured
      // browser bytes, not source, and fail every rule a file can fail.
      // The suffixed spellings are the parallel-group variants
      // scripts/e2e/run.mjs writes and any ad-hoc diagnostic lane's.
      "!**/e2e/.artifacts*",
      "!**/e2e/.run-*",
      "!**/e2e/.auth*",
      "!**/e2e/.state*.json",
      "!next-env.d.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "css": {
    "parser": {
      // `globals.css` is a Tailwind v4 theme file: `@theme`, `@custom-variant`
      // and `@apply` are the whole point of it. Without this, Biome cannot parse
      // the one stylesheet this project has, and reports it as a syntax error.
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        // A `<label>` wrapping a control is a valid association — the rule just
        // cannot see through a component boundary. `Input`, `Checkbox` and the
        // rest render a real `<input>` inside, so naming them here restores the
        // check for everything else rather than switching the rule off.
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "Checkbox", "Textarea", "Select", "RadioGroupItem"]
          }
        }
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      // The vendored Label is a transparent primitive: the concrete control and
      // htmlFor arrive from its caller, so a file-local static rule cannot prove
      // the association. Keep the exception on this one primitive only.
      "includes": ["src/components/ui/label.tsx"],
      "linter": { "rules": { "a11y": { "noLabelWithoutControl": "off" } } }
    },
    {
      // These vendored ARIA primitives deliberately use roles where the exact
      // HTML element cannot express the component's polymorphic contract.
      "includes": [
        "src/components/ui/alert.tsx",
        "src/components/ui/breadcrumb.tsx",
        "src/components/ui/combobox.tsx",
        "src/components/ui/field.tsx",
        "src/components/ui/input-group.tsx",
        "src/components/ui/spinner.tsx"
      ],
      "linter": { "rules": { "a11y": { "useSemanticElements": "off" } } }
    },
    {
      // Current-page breadcrumbs intentionally are not extra tab stops.
      "includes": ["src/components/ui/breadcrumb.tsx"],
      "linter": { "rules": { "a11y": { "useFocusableInteractive": "off" } } }
    },
    {
      // The add-on's pointer handler only forwards focus to the adjacent input;
      // keyboard users already reach that input directly.
      "includes": ["src/components/ui/input-group.tsx"],
      "linter": { "rules": { "a11y": { "useKeyWithClickEvents": "off" } } }
    },
    {
      // Only components that actually own hook dependency arrays get the
      // vendored-library exemption; newly added UI primitives are linted by the
      // normal project rule instead of inheriting a directory-wide blind spot.
      "includes": [
        "src/components/ui/combobox.tsx",
        "src/components/ui/date-picker.tsx",
        "src/components/ui/field.tsx",
        "src/components/ui/sidebar.tsx",
        "src/hooks/use-mobile.ts"
      ],
      "linter": { "rules": { "correctness": { "useExhaustiveDependencies": "off" } } }
    },
    {
      // Sidebar persistence is intentionally a first-party, non-sensitive UI
      // cookie. No other component receives a blanket document.cookie waiver.
      "includes": ["src/components/ui/sidebar.tsx"],
      "linter": { "rules": { "suspicious": { "noDocumentCookie": "off" } } }
    }
  ]
}
