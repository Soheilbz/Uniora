# Web development environment. Copy to .env.local and replace placeholders.
NODE_ENV=development
DATABASE_URL=postgresql://univ_app_web:local@127.0.0.1:5446/univ?sslmode=disable
BETTER_AUTH_SECRET=replace-with-a-local-secret-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:3020
TRUSTED_ORIGINS=http://127.0.0.1:3020
EXPORT_JOB_DIR=./.univ/exports
MFA_ENCRYPTION_KEY=replace-with-a-distinct-local-mfa-key-at-least-32-chars
PLATFORM_OPERATION_ENCRYPTION_KEY=replace-with-a-distinct-local-platform-key-32-chars
INTEGRATION_ENCRYPTION_KEY=replace-with-a-distinct-local-integration-key-32-chars
PUBLIC_FORM_RATE_SALT=replace-with-a-distinct-local-public-form-salt-32-chars
OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9100
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9100
OBJECT_STORAGE_BROWSER_ORIGIN=http://127.0.0.1:9100
OBJECT_STORAGE_BUCKET=univ-local
OBJECT_STORAGE_ACCESS_KEY_ID=local-dev
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-a-local-storage-secret
OBJECT_STORAGE_PATH_STYLE=true
PLATFORM_SESSION_HOURS=4
TRUSTED_PROXY_HOPS=1
