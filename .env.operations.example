# One-shot operations profile. Keep this file outside the Web process.
DATABASE_ADMIN_URL=postgresql://univ_owner:replace-me@db.example:5432/univ?sslmode=verify-full
APP_DB_PASSWORD=replace-me
WORKER_DB_PASSWORD=replace-me
PLATFORM_DB_PASSWORD=replace-me
DATABASE_URL=postgresql://univ_app_web:replace-me@db.example:5432/univ?sslmode=verify-full
DATABASE_WORKER_URL=postgresql://univ_job_worker:replace-me@db.example:5432/univ?sslmode=verify-full
DATABASE_PLATFORM_URL=postgresql://univ_platform_worker:replace-me@db.example:5432/univ?sslmode=verify-full
BETTER_AUTH_SECRET=replace-with-a-production-secret-at-least-32-characters
BETTER_AUTH_URL=https://univ.example.com
BACKUP_ACTIVE_KEY_ID=replace-me
BACKUP_ENCRYPTION_KEYS=replace-me
MFA_ACTIVE_KEY_ID=replace-me
MFA_ENCRYPTION_KEYS=replace-me
PLATFORM_OPERATION_ENCRYPTION_KEY=replace-me
PLATFORM_SESSION_HOURS=4
MFA_ROTATION_CONFIRM=ROTATE_MFA_KEYS
AUDIT_SEAL_DIR=/srv/univ/audit-seals
AUDIT_SEAL_KEY=replace-me
DR_REPORT_DIR=/srv/univ/dr-reports
DR_TARGET_RPO_MINUTES=60
DR_TARGET_RTO_MINUTES=240
